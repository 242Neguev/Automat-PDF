<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS : ajouts à l'Info.plist de l'application (Tauri les fusionne avec le sien, en mode
  développement comme dans l'application installée).
  - CFBundleDevelopmentRegion, CFBundleAllowMixedLocalizations : l'application est en français ;
    les fenêtres de macOS (ouvrir, enregistrer) suivent la langue du système.
  - NSAppleEventsUsageDescription : raison affichée par macOS quand Automat-PDF demande à piloter
    Word, Excel, PowerPoint ou Mail (Office en PDF, PDF en Word, envoi par Mail).
  - NSServices : clic droit dans le Finder, comme le sous-menu de l'Explorateur sous Windows
    (src-tauri/windows/clic-droit.nsh). Chaque service confie les fichiers choisis à l'outil
    nommé dans NSUserData (src/outils.tsx) ; NSRequiredContext, même vide, l'active d'emblée.
  - CFBundleDocumentTypes : Automat-PDF ouvre les PDF (« Ouvrir avec » du Finder), au rang
    « Alternate » : macOS ne le choisit jamais d'office comme lecteur des PDF ; l'application le
    propose, et macOS demande à l'utilisateur de confirmer (src-tauri/src/lecteur_defaut.rs).
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Document PDF</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<key>NSAppleEventsUsageDescription</key>
	<string>Automat-PDF pilote Microsoft Word, Excel et PowerPoint pour convertir vos documents, et Mail pour préparer ou envoyer vos messages.</string>
	<key>NSServices</key>
	<array>
